{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/OPENCODE-BRIEF.md", "docs/RENCANA-POLISH-UI.md"],
  "share": "disabled",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*dev.db*": "deny",
      "*.vapid.json": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*dev.db*": "deny",
      "*.vapid.json": "deny",
      "*package.json": "deny",
      "*pnpm-lock.yaml": "deny",
      "*infra/*": "deny",
      "*server/face/*": "deny",
      "*server/models/*": "deny",
      "*opencode.json": "deny"
    },
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sed -n *": "allow",
      "echo *": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "diff *": "allow",
      "npx tsc*": "allow",
      "pnpm lint*": "allow",
      "pnpm build*": "allow",
      "pnpm -s lint*": "allow",
      "pnpm -s build*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git clean*": "deny",
      "git checkout*": "deny",
      "git config*": "deny",
      "rm *": "deny",
      "pnpm add*": "deny",
      "pnpm install*": "deny",
      "pnpm remove*": "deny",
      "npm *": "deny",
      "sqlite3 *": "deny",
      "curl *": "deny"
    },
    "external_directory": "deny",
    "webfetch": "allow",
    "doom_loop": "ask"
  }
}
